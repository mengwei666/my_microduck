<!-- items_showcase.xml — 物品展示/摆放台
     所有物品都是 freejoint(可动体),MuJoCo viewer 里可被物理推动;
     也可用配套摆放脚本(键盘)拾取平移。
     查看: uv run python -m mujoco.viewer <本文件路径>
-->
<mujoco model="items_showcase">
  <compiler angle="degree"/>
  <asset>
    <texture type="2d" name="tex_floor" builtin="checker" width="300" height="300" rgb1="0.75 0.75 0.75" rgb2="0.55 0.55 0.55"/>
    <material name="floor_mat" texture="tex_floor" texrepeat="6 4"/>
    <material name="m_red"    rgba="0.85 0.25 0.25 1"/>
    <material name="m_blue"   rgba="0.25 0.35 0.85 1"/>
    <material name="m_green"  rgba="0.25 0.75 0.30 1"/>
    <material name="m_orange" rgba="0.95 0.60 0.10 1"/>
    <material name="m_cyan"   rgba="0.25 0.75 0.75 1"/>
    <material name="m_brown"  rgba="0.55 0.35 0.20 1"/>
    <material name="m_gray"   rgba="0.65 0.65 0.65 1"/>
    <material name="m_white"  rgba="0.95 0.95 0.95 1"/>
    <material name="m_yellow" rgba="0.95 0.85 0.20 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="4 3 0.1" material="floor_mat"/>

    <!-- 1) 球 -->
    <body name="ball" pos="-3.0 0 0.05">
      <freejoint/>
      <geom type="sphere" size="0.05" material="m_orange"/>
    </body>

    <!-- 2) 杯子 (mug):薄壁用开口圆柱近似 -->
    <body name="mug" pos="-2.5 0 0.05">
      <freejoint/>
      <geom type="cylinder" size="0.035 0.09" material="m_red"/>
      <geom type="cylinder" size="0.028 0.087" material="m_white" pos="0 0 0.002"/>
    </body>

    <!-- 3) 毛巾:薄扁盒 -->
    <body name="towel" pos="-2.0 0 0.01">
      <freejoint/>
      <geom type="box" size="0.12 0.19 0.005" material="m_cyan"/>
    </body>

    <!-- 4) 箱子/快递盒 -->
    <body name="box_cargo" pos="-1.5 0 0.10">
      <freejoint/>
      <geom type="box" size="0.09 0.09 0.09" material="m_brown"/>
    </body>

    <!-- 5) 椅子 -->
    <body name="chair" pos="-1.0 0.1 0">
      <freejoint/>
      <geom type="box" size="0.16 0.16 0.25" material="m_gray" pos="0 0 0.25"/>
      <geom type="box" size="0.14 0.14 0.03" material="m_blue" pos="0 0 0.53"/>
      <geom type="cylinder" size="0.02 0.27" material="m_gray" pos="0.11 0.11 0.135"/>
      <geom type="cylinder" size="0.02 0.27" material="m_gray" pos="-0.11 0.11 0.135"/>
      <geom type="cylinder" size="0.02 0.27" material="m_gray" pos="0.11 -0.11 0.135"/>
      <geom type="cylinder" size="0.02 0.27" material="m_gray" pos="-0.11 -0.11 0.135"/>
    </body>

    <!-- 6) 小桌 -->
    <body name="side_table" pos="-0.5 0 0.18">
      <freejoint/>
      <geom type="box" size="0.15 0.15 0.02" material="m_brown" pos="0 0 0.18"/>
      <geom type="cylinder" size="0.015 0.18" material="m_gray" pos="0.10 0.10 0.09"/>
      <geom type="cylinder" size="0.015 0.18" material="m_gray" pos="-0.10 0.10 0.09"/>
      <geom type="cylinder" size="0.015 0.18" material="m_gray" pos="0.10 -0.10 0.09"/>
      <geom type="cylinder" size="0.015 0.18" material="m_gray" pos="-0.10 -0.10 0.09"/>
    </body>

    <!-- 7) 楼梯:3 级台阶(固定,不可拖) -->
    <body name="stairs" pos="0.5 -0.6 0">
      <geom type="box" size="0.35 0.10 0.05" material="m_gray"    pos="0    0 0.05"/>
      <geom type="box" size="0.25 0.10 0.05" material="m_white"   pos="0.10 0 0.15"/>
      <geom type="box" size="0.15 0.10 0.05" material="m_yellow"  pos="0.20 0 0.25"/>
    </body>

    <!-- 8) 斜坡(可拖 box 近似) -->
    <body name="ramp" pos="1.0 0 0.05" euler="0 8 0">
      <freejoint/>
      <geom type="box" size="0.30 0.20 0.03" material="m_green"/>
    </body>

    <!-- 9) 立柱/衣柜杆 -->
    <body name="pole" pos="1.5 0 0.5">
      <freejoint/>
      <geom type="cylinder" size="0.025 0.45" material="m_blue"/>
    </body>

    <!-- 10) 垫子/瑜伽垫 -->
    <body name="mat" pos="2.0 0 0.01">
      <freejoint/>
      <geom type="box" size="0.35 0.18 0.008" material="m_yellow"/>
    </body>

    <!-- 11) 牛奶盒/瓶子 -->
    <body name="bottle" pos="2.5 0 0.06">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.12" material="m_white"/>
      <geom type="cylinder" size="0.013 0.04" material="m_gray" pos="0 0 0.08"/>
    </body>

    <!-- 12) 足球 -->
    <body name="football" pos="3.0 0 0.06">
      <freejoint/>
      <geom type="sphere" size="0.055" material="m_white"/>
    </body>
  </worldbody>
</mujoco>